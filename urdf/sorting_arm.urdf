
<?xml version="1.0"?>
<robot name="sorting_arm">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <cylinder radius="0.28" length="0.30"/>
      </geometry>
      <material name="blue">
        <color rgba="0.05 0.35 0.95 1"/>
      </material>
    </visual>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.35"/>
      <geometry>
        <box size="0.20 0.20 0.70"/>
      </geometry>
      <material name="blue">
        <color rgba="0.05 0.35 0.95 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.30"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14"
           effort="20" velocity="1"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0.45 0 0"/>
      <geometry>
        <box size="0.90 0.18 0.18"/>
      </geometry>
      <material name="blue">
        <color rgba="0.05 0.35 0.95 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.70"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.4" upper="1.4"
           effort="20" velocity="1"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0.35 0 0"/>
      <geometry>
        <box size="0.70 0.15 0.15"/>
      </geometry>
      <material name="blue">
        <color rgba="0.05 0.35 0.95 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.90 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0"
           effort="20" velocity="1"/>
  </joint>

  <link name="gripper">
    <visual>
      <origin xyz="0.10 0 0"/>
      <geometry>
        <box size="0.20 0.16 0.16"/>
      </geometry>
      <material name="blue">
        <color rgba="0.05 0.35 0.95 1"/>
      </material>
    </visual>
  </link>

  <joint name="gripper_joint" type="fixed">
    <parent link="link3"/>
    <child link="gripper"/>
    <origin xyz="0.70 0 0"/>
  </joint>

  <link name="left_finger">
    <visual>
      <origin xyz="0 0.075 -0.09"/>
      <geometry>
        <box size="0.14 0.04 0.18"/>
      </geometry>
      <material name="blue">
        <color rgba="0.05 0.35 0.95 1"/>
      </material>
    </visual>
  </link>

  <joint name="left_finger_joint" type="fixed">
    <parent link="gripper"/>
    <child link="left_finger"/>
    <origin xyz="0 0 0"/>
  </joint>

  <link name="right_finger">
    <visual>
      <origin xyz="0 -0.075 -0.09"/>
      <geometry>
        <box size="0.14 0.04 0.18"/>
      </geometry>
      <material name="blue">
        <color rgba="0.05 0.35 0.95 1"/>
      </material>
    </visual>
  </link>

  <joint name="right_finger_joint" type="fixed">
    <parent link="gripper"/>
    <child link="right_finger"/>
    <origin xyz="0 0 0"/>
  </joint>

</robot>
