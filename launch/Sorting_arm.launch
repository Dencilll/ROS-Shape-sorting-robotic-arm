<launch>
    <param name="robot_description"
           command="$(find xacro)/xacro $(find shape_sorting_robot)/urdf/sorting_arm.urdf"/>

    <node name="robot_state_publisher"
          pkg="robot_state_publisher"
          type="robot_state_publisher"/>

    <node name="rviz"
          pkg="rviz"
          type="rviz"
          args="-f base_link"/>
</launch>
